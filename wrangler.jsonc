{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova26",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "254c4deb-eb8f-477e-acc7-6c8dabd8272b","database_name": "alex" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3c6d8c537c784548afd36fbde831f8fc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
